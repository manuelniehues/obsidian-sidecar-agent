{
  "name": "obsidian-sidecar-agent",
  "version": "1.1.0",
  "description": "Obsidian plugin: Claude Code and Antigravity in a real terminal in the sidebar.",
  "private": true,
  "license": "MIT",
  "author": "Manuel Niehues",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src",
    "format": "prettier --write src styles.css",
    "check": "node scripts/check-i18n.mjs && npm run lint && npm run build",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.13.0",
    "obsidian": "1.14.4",
    "prettier": "3.9.10"
  }
}
